# ==========================================
# VARIABLES DE ENTORNO - SUPABASE EDGE FUNCTIONS
# ==========================================
# Copia este archivo como `.env.local` para desarrollo local
# y no lo incluyas en tus commits (agrega .env.local a tu .gitignore).

# ── 1. SUPABASE (Variables automáticas en la nube, pero necesarias localmente) ──
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="tu_anon_key_aqui"
SUPABASE_SERVICE_ROLE_KEY="tu_service_role_key_aqui"

# ── 2. STRIPE (Pagos) ──
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── 3. PAYPAL (Pagos) ──
PAYPAL_CLIENT_ID="tu_paypal_client_id"
PAYPAL_CLIENT_SECRET="tu_paypal_client_secret"
PAYPAL_WEBHOOK_ID="tu_paypal_webhook_id"

# ── 4. RESEND (Envío de correos) ──
RESEND_API_KEY="re_..."
# Correo desde donde se enviarán (debe estar verificado en Resend)
EMAIL_FROM="hola@tudominio.com"

# ── 5. GOOGLE CALENDAR (Sincronización de citas) ──
GOOGLE_CALENDAR_CLIENT_ID="tu_client_id.apps.googleusercontent.com"
GOOGLE_CALENDAR_CLIENT_SECRET="tu_client_secret"
GOOGLE_CALENDAR_REFRESH_TOKEN="tu_refresh_token"
# El ID del calendario específico a usar (usualmente el correo principal)
GOOGLE_CALENDAR_ID="tu_correo@gmail.com"

# ── 6. CLOUDINARY (Gestión de imágenes y videos) ──
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# ── 7. PUSH NOTIFICATIONS (VAPID Keys) ──
VAPID_PUBLIC_KEY="tu_vapid_public_key"
VAPID_PRIVATE_KEY="tu_vapid_private_key"
